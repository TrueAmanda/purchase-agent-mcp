# Compose reads .env automatically. Empty values use local development defaults.
POSTGRES_DB=purchase_agent
POSTGRES_USER=purchase_agent
# Empty uses purchase_local_only in Compose; replace for shared environments.
POSTGRES_PASSWORD=
BACKEND_PORT=8000
MCP_PORT=8001
FRONTEND_PORT=5173
DB_STARTUP_ATTEMPTS=30
DB_STARTUP_INTERVAL_SECONDS=2

# Backend outside Docker only. Compose always uses postgres:5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=

# Reserved for future agent integration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
MCP_SERVER_URL=http://mcp-server:8001/mcp

# Public frontend configuration only
VITE_API_BASE_URL=/api
