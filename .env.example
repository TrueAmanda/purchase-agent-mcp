# Compose reads .env automatically. Empty values use local development defaults.
POSTGRES_DB=purchase_agent
POSTGRES_USER=purchase_agent
# Empty uses purchase_local_only in Compose; replace for shared environments.
POSTGRES_PASSWORD=
BACKEND_PORT=8000
MCP_PORT=8001
PRODUCT_API_TIMEOUT_SECONDS=10
FRONTEND_PORT=5173
DB_STARTUP_ATTEMPTS=30
DB_STARTUP_INTERVAL_SECONDS=2

# Backend and MCP outside Docker only. Compose always uses postgres:5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=

# OpenRouter agent: required only when invoking the agent. Never use a real key here.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_TEMPERATURE=0
OPENROUTER_MAX_TOKENS=2048
AGENT_MAX_ITERATIONS=8
AGENT_MAX_TOOL_CALLS_PER_ITERATION=8
AGENT_TOOL_TIMEOUT_SECONDS=15
AGENT_RUN_TIMEOUT_SECONDS=120
AGENT_MAX_CONCURRENT_RUNS=4
CONVERSATION_TTL_SECONDS=1800
CONVERSATION_MAX_COUNT=100
CONVERSATION_MAX_TURNS=6
CONVERSATION_MAX_HISTORY_CHARACTERS=200000
# Outside Docker; Compose uses http://mcp-server:8001/mcp internally.
MCP_SERVER_URL=http://localhost:8001/mcp
MCP_TIMEOUT_SECONDS=15

# Public frontend URL, embedded at build time. Rebuild the frontend after changing.
# For local Vite development, put this value in frontend/.env.local or the process environment.
VITE_API_BASE_URL=/api
